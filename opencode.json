{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "agentworks/glm-5-3",
  "mcp": {
    "agentworks": {
      "type": "local",
      "command": ["agentworks", "mcp", "serve"],
      "enabled": true,
      "environment": {
        "AGENTWORKS_API_URL": "https://api.thoughtworks.polis.thoughtworks-labs.net",
        "AGENTWORKS_PROFILE": "default"
      }
    }
  },
  "provider": {
    "agentworks": {
      "name": "AgentWorks",
      "options": {
        "apiKey": "{env:AGENTWORKS_API_KEY}",
        "baseURL": "https://api.thoughtworks.polis.thoughtworks-labs.net/v1/inference"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "agentworks/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 8192 },
          "cost": { "input": 0.14, "output": 0.28 }
        },
        "deepseek-v4-pro": {
          "id": "agentworks/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 8192 },
          "cost": { "input": 1.74, "output": 3.48 }
        },
       "gemma-4": {
          "id": "agentworks/gemma-4-31b-it",
          "name": "Gemma 4",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 },
          "cost": { "input": 0.14, "output": 0.40 }
        },
          "glm-5-3": {
          "id": "agentworks/glm-5-3",
          "name": "GLM 5.3",
          "tool_call": true,
          "limit": { "context": 524288, "output": 65536 },
          "cost": { "input": 1.40, "output": 4.40 }
        }

      }
    }
  }
}